# Copy to ignored .env.local; generate unique local passwords. Do not commit secrets.
LOCAL_DBA_PASSWORD=
LOCAL_TEMPORAL_PASSWORD=
LOCAL_FORGE_OWNER_PASSWORD=
LOCAL_FORGE_RUNTIME_PASSWORD=
LOCAL_FORGE_TRUST_PASSWORD=
LOCAL_FORGE_ISSUER_PASSWORD=
LOCAL_FORGE_SETUP_PASSWORD=
LOCAL_FORGE_RECOVERY_PASSWORD=
FORGE_AUTHORITY_BACKEND=postgres
FORGE_POSTGRES_CONNECTION_STRING=postgres://forge_runtime:REPLACE@127.0.0.1:54329/forge
FORGE_POSTGRES_SCHEMA=forge
FORGE_POSTGRES_ROLE=forge_runtime
FORGE_AUTHORITY_ID=
FORGE_WORKER_REPOSITORY_PATH=/Users/isdance/Desktop/projects/ground-graph-ts
FORGE_WORKER_AUTHORITY_MODE=global
TEMPORAL_SERVER_URL=http://127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=groundgraph-local
FORGE_PI_IMAGE=
FORGE_GIT_IMAGE=alpine/git@sha256:832b1cd1a271509f3d5272a1a62d4cb2ab1a53426ebde1f6c2cb7349f907dc6f
FORGE_WORKER_REVIEW_PROVIDER=deepseek
FORGE_WORKER_REVIEW_MODEL=deepseek-flash
FORGE_MODEL_API_KEY=
# Required deployment policy: thinking enabled, high effort for all agent roles.
FORGE_MODEL_REASONING_EFFORT=high
# Keep the default five-minute session budget unless the deployment explicitly approves another budget.
FORGE_PI_SESSION_TIMEOUT_MS=300000
# Git identity belongs to the confined deployment, not the target repository's config.
FORGE_GIT_AUTHOR_NAME=Forge Local Experiment
FORGE_GIT_AUTHOR_EMAIL=forge-local@localhost
# Optional dependency-provisioned verification image; approve its fingerprint in a new plan.
FORGE_VERIFICATION_IMAGE=
# Optional standalone trace export check. Keep the real Authorization header only in ignored .env.local.
# OTEL_SERVICE_NAME=forge-local
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector.example/otlp
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic BASE64_CREDENTIAL"
# OTEL_TRACES_EXPORTER=otlp
# Enable only on a fresh Temporal queue/authority; tracing interceptors add workflow history.
# FORGE_OTEL_INSTRUMENTATION=1
# When an image is configured, the local Linux dependency image needs these approved settings:
# FORGE_VERIFICATION_TEMPORARY_BYTES=2147483648
# FORGE_VERIFICATION_TEMPORARY_EXECUTABLE=true

# Actual database-owner login, used only by neon-database-hardening.mjs.
FORGE_DATABASE_OWNER_CONNECTION_STRING=
# Forge authority role URLs must have no startup query parameters.
# Set explicit transport for Neon and every non-loopback PostgreSQL deployment.
# FORGE_POSTGRES_SSL=verify-full
# Loopback development can omit this setting or use FORGE_POSTGRES_SSL=false.
FORGE_OWNER_CONNECTION_STRING=
FORGE_RUNTIME_CONNECTION_STRING=
FORGE_TRUST_CONNECTION_STRING=
FORGE_ISSUER_CONNECTION_STRING=
FORGE_SETUP_CONNECTION_STRING=
FORGE_RECOVERY_CONNECTION_STRING=
