{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug built CLI",
      "program": "${workspaceFolder}/apps/cli/dist/main.js",
      "args": ["--help"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/cli/dist/**/*.js", "!**/node_modules/**"]
    }
  ]
}
